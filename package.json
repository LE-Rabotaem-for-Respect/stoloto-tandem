{
  "name": "stoloto-tandem",
  "private": true,
  "workspaces": [
    "packages/domain",
    "apps/api",
    "apps/web",
    "e2e"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:domain": "npm run build -w @tandem/domain",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run build:domain && npm run typecheck --workspaces --if-present",
    "test": "npm run build:domain && npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w @tandem/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
